# Servizio systemd per la pagina di consultazione su una VPS Linux.
# 1. Cambia User= e WorkingDirectory= (la cartella del progetto) qui sotto.
# 2. sudo cp deploy/db-serio-web.service /etc/systemd/system/
#    sudo systemctl daemon-reload && sudo systemctl enable --now db-serio-web
# 3. Stato e messaggi:  systemctl status db-serio-web   ·   journalctl -u db-serio-web -f
# Le impostazioni (database, WEB_HOST, WEB_PORTA, WEB_UTENTE, WEB_PASSWORD) restano nel file .env del progetto.
[Unit]
Description=db_serio - pagina di consultazione del catalogo materiali
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dbserio
WorkingDirectory=/opt/db_serio
ExecStart=/usr/bin/env bash /opt/db_serio/avvia_web.sh
Restart=on-failure
RestartSec=5
Environment=PYTHONIOENCODING=utf-8
# il servizio non ha bisogno di scrivere da nessuna parte
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
