# Copia questo file in ".env" (nella stessa cartella) e cambia i valori. ".env" non va su git.
PGDATABASE=db_serio_finale
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# PGPASSWORD=
# Cartella con i CSV dei cataloghi gia' filtrati (si importa col solo nome del file)
# CARTELLA_CATALOGHI=C:\percorso\cataloghi_filtrati
# Cartella con Flash_Delivery_Linee_per_Brand.xlsx e cataloghi\*.csv (solo per import_catalogo.py)
# ORIGINE_CATALOGHI=C:\percorso\cartella

# --- Pagina web (web/server.py, avvia_web.bat / avvia_web.sh) ---
# Sul PC lascia tutto com'e' (solo http://localhost:8001). Su una VPS:
#   WEB_HOST=0.0.0.0 se si apre direttamente la porta; WEB_HOST=127.0.0.1 se davanti c'e' nginx (consigliato, con HTTPS).
#   Fuori da 127.0.0.1 la password e' obbligatoria (senza, il sito non parte).
# WEB_HOST=127.0.0.1
# WEB_PORTA=8001
# WEB_UTENTE=flash
# WEB_PASSWORD=
